<Window x:Class="MultiWindowApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiWindowApp"
        WindowState="Maximized"
        Style="{StaticResource BaseWindowStyle}">

    <Grid Margin="10">
        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center">
            <UniformGrid Rows="3"
                         Columns="3"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center">

                <Button Content="Метод дихотомии"
                        Width="200"
                        Height="56"
                        Margin="8"
                        FontSize="14"
                        Padding="16,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="DichotomyButton_Click"/>

                <Button Content="Решение СЛАУ"
                        Width="200"
                        Height="56"
                        Margin="8"
                        FontSize="14"
                        Padding="16,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="LinearSystemButton_Click"/>

                <Button Content="Метод золотого сечения"
                        Width="200"
                        Height="56"
                        Margin="8"
                        FontSize="14"
                        Padding="16,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="GoldenSectionButton_Click"/>

                <Button Content="Метод Ньютона"
                        Width="200"
                        Height="56"
                        Margin="8"
                        FontSize="14"
                        Padding="16,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="NewtonButton_Click"/>

                <Button Content="Метод покоординатного спуска"
                        Width="200"
                        Height="56"
                        Margin="8"
                        FontSize="14"
                        Padding="16,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="CoordinateDescentButton_Click"/>

                <Button Content="Интегралы"
                        Width="200"
                        Height="56"
                        Margin="8"
                        FontSize="14"
                        Padding="16,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="IntegralButton_Click"/>

                <Button Content="Метод наименьших квадратов"
                        Width="200"
                        Height="56"
                        Margin="8"
                        FontSize="14"
                        Padding="16,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="LeastSquaresButton_Click"/>

                <Button Content="Алгоритмы сортировки"
                        Width="200"
                        Height="56"
                        Margin="8"
                        FontSize="14"
                        Padding="16,0"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="SortingButton_Click"/>

                <Button Content="Выход"
                        Width="200"
                        Height="56"
                        Margin="8"
                        FontSize="14"
                        Padding="16,0"
                        Style="{StaticResource GhostButtonStyle}"
                        Click="ExitButton_Click"/>

            </UniformGrid>
        </Grid>
    </Grid>
</Window>