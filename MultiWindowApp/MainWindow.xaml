<Window x:Class="MultiWindowApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MultiWindowApp"
        Height="300"
        Width="400"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="300">

            <Button Content="Метод дихотомии"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="DichotomyButton_Click"/>

            <Button Content="Решение СЛАУ"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="LinearSystemButton_Click"/>

            <Button Content="Метод золотого сечения"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="GoldenSectionButton_Click"/>

            <Button Content="Метод Ньютона"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="NewtonButton_Click"/>

            <Button Content="Метод покоординатного спуска"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="CoordinateDescentButton_Click"/>

            <Button Content="Интегралы"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="IntegralButton_Click"/>

            <Button Content="Метод наименьших квадратов"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="LeastSquaresButton_Click"/>

            <Button Content="Алгоритмы сортировки"
                    Height="40"
                    Margin="0,0,0,10"
                    Click="SortingButton_Click"/>

            <Button Content="Выход"
                    Height="40"
                    Click="ExitButton_Click"/>

        </StackPanel>
    </Grid>
</Window>