<Window x:Class="MultiWindowApp.SortingAlgorithmsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Алгоритмы сортировки"
        WindowState="Maximized"
        Style="{StaticResource BaseWindowStyle}">
    <DockPanel Margin="10">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Действия">
                <MenuItem Header="Рассчитать" Click="CalculateMenuItem_Click"/>
                <MenuItem Header="Очистить" Click="ClearMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Загрузить из CSV/Excel" Click="LoadFromCsvMenuItem_Click"/>
                <MenuItem Header="Загрузить из Google Table" Click="LoadFromGoogleMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Сгенерировать тестовые данные" Click="GenerateMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="Закрыть" Click="CloseMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,8,0"
                    Padding="8"
                    Background="White"
                    CornerRadius="6"
                    BorderBrush="#FFD0D0E0"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Исходные данные"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,6"/>

                    <DataGrid x:Name="DataGridValues"
                              AutoGenerateColumns="False"
                              CanUserAddRows="True"
                              CanUserDeleteRows="True"
                              HeadersVisibility="Column"
                              Margin="0,0,0,8"
                              Height="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Значение"
                                                Binding="{Binding Value}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,8">
                        <Label Content="Количество элементов:"
                               VerticalAlignment="Center"/>
                        <TextBox x:Name="CountTextBox"
                                 Width="60"
                                 Margin="6,0,0,0"/>
                        <Label Content="Максимум:"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                        <TextBox x:Name="MaxValueTextBox"
                                 Width="60"
                                 Margin="6,0,0,0"/>
                    </StackPanel>

                    <Border Margin="0,0,0,6"
                            Padding="6"
                            Background="#FFF5F7FF"
                            BorderBrush="#FFC8D0F0"
                            BorderThickness="1"
                            CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="Выбор алгоритмов"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>
                            <WrapPanel>
                                <CheckBox x:Name="BubbleCheckBox"
                                          Content="Пузырьковая"
                                          Margin="0,0,10,4"/>
                                <CheckBox x:Name="InsertionCheckBox"
                                          Content="Вставками"
                                          Margin="0,0,10,4"/>
                                <CheckBox x:Name="ShakerCheckBox"
                                          Content="Шейкерная"
                                          Margin="0,0,10,4"/>
                                <CheckBox x:Name="QuickCheckBox"
                                          Content="Быстрая"
                                          Margin="0,0,10,4"/>
                                <CheckBox x:Name="BogoCheckBox"
                                          Content="BOGO"
                                          Margin="0,0,10,4"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,4">
                        <TextBlock Text="Порядок сортировки:"
                                   VerticalAlignment="Center"/>
                        <RadioButton x:Name="AscendingRadioButton"
                                     Content="По возрастанию"
                                     IsChecked="True"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center"/>
                       <RadioButton x:Name="DescendingRadioButton"
                                     Content="По убыванию"
                                     Margin="8,0,0,0"
                                     VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="StatusTextBlock"
                               Margin="0,4,0,0"
                               Foreground="DarkSlateGray"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Padding="8"
                    Background="White"
                    CornerRadius="6"
                    BorderBrush="#FFD0D0E0"
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Визуализация сортировок"
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,6"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Пузырьковая"
                                           FontWeight="SemiBold"/>
                                <Canvas x:Name="BubbleCanvas"
                                        Height="80"
                                        Margin="0,2,0,4"
                                        Background="#FFF9FAFF"/>
                                <TextBlock x:Name="BubbleTimeText"
                                           FontSize="11"
                                           Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Вставками"
                                           FontWeight="SemiBold"/>
                                <Canvas x:Name="InsertionCanvas"
                                        Height="80"
                                        Margin="0,2,0,4"
                                        Background="#FFF9FAFF"/>
                                <TextBlock x:Name="InsertionTimeText"
                                           FontSize="11"
                                           Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Шейкерная"
                                           FontWeight="SemiBold"/>
                                <Canvas x:Name="ShakerCanvas"
                                        Height="80"
                                        Margin="0,2,0,4"
                                        Background="#FFF9FAFF"/>
                                <TextBlock x:Name="ShakerTimeText"
                                           FontSize="11"
                                           Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Быстрая"
                                           FontWeight="SemiBold"/>
                                <Canvas x:Name="QuickCanvas"
                                        Height="80"
                                        Margin="0,2,0,4"
                                        Background="#FFF9FAFF"/>
                                <TextBlock x:Name="QuickTimeText"
                                           FontSize="11"
                                           Foreground="Gray"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,0">
                                <TextBlock Text="BOGO"
                                           FontWeight="SemiBold"/>
                                <Canvas x:Name="BogoCanvas"
                                        Height="80"
                                        Margin="0,2,0,4"
                                        Background="#FFF9FAFF"/>
                                <TextBlock x:Name="BogoTimeText"
                                           FontSize="11"
                                           Foreground="Gray"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>

